# Supabase: Settings > API do seu projeto
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Só no servidor (nunca NEXT_PUBLIC_): usada pelo cron de automações
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key
CRON_SECRET=uma-string-aleatoria-longa

# Opcionais
ANTHROPIC_API_KEY=            # sugestão de mensagens por IA no Funil
RESEND_API_KEY=               # e-mails de lembrete/alerta
RESEND_FROM_EMAIL=CRM Aventure <crm@seudominio.com>
